# Docker database.
APP_PORT=3000
POSTGRES_DB=openachieve
POSTGRES_USER=openachieve
POSTGRES_PASSWORD=replace_with_a_strong_database_password
DATABASE_URL=postgres://openachieve:replace_with_a_strong_database_password@db:5432/openachieve

# Backend runtime.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DEFAULT_MONTHLY_REQUEST_LIMIT=500
ADMIN_EMAILS=xiaolinyihai@gmail.com
CORS_ALLOWED_ORIGINS=https://openachieve.asia
APP_BASE_URL=https://openachieve.asia

# SMTP email verification. Required for new public registrations.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=noreply@openachieve.asia
SMTP_FROM_NAME=OpenAchieve
SMTP_TLS_MODE=starttls

# Multi-key mode. Keep Zen and Go keys separate so Free traffic cannot silently use Go spend.
OPENCODE_ZEN_API_KEYS=replace_with_zen_key_1,replace_with_zen_key_2
OPENCODE_GO_API_KEYS=replace_with_go_key_1,replace_with_go_key_2

ZEN_CHAT_COMPLETIONS_URL=https://opencode.ai/zen/v1/chat/completions
ZEN_GO_CHAT_COMPLETIONS_URL=https://opencode.ai/zen/go/v1/chat/completions
ZEN_GO_MESSAGES_URL=https://opencode.ai/zen/go/v1/messages
ZEN_MODELS_URL=https://opencode.ai/zen/v1/models
ZEN_GO_MODELS_URL=https://opencode.ai/zen/go/v1/models
UPSTREAM_MAX_ATTEMPTS=4
UPSTREAM_RETRY_BASE_MS=300
UPSTREAM_KEY_COOLDOWN_MS=60000

# FovPay Plus checkout. Keep disabled until FOVPAY_PID and FOVPAY_SECRET_KEY are set.
FOVPAY_ENABLED=false
FOVPAY_BASE_URL=https://pay.fovpay.com
FOVPAY_PID=replace_with_fovpay_pid
FOVPAY_SECRET_KEY=replace_with_fovpay_md5_secret
FOVPAY_PLUS_AMOUNT_CNY=58.00
FOVPAY_PLUS_DAYS=30
FOVPAY_ALLOWED_PAYTYPES=alipay,wxpay
FOVPAY_DISABLED_PAYTYPES=paypal,usdt
